# --- Quarto & Web Outputs ---
# We ignore the default _site because you use the docs/ folder
_site/
.quarto/
# site_libs/ is usually inside docs/, so we ignore any root versions
site_libs/

# --- R Specific Files ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# --- OS / System Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- CRITICAL: DO NOT IGNORE docs/ ---
# Since you are using 'output-dir: docs' in your _quarto.yml,
# this folder MUST be tracked by Git to show up on GitHub Pages.
# If "docs/" appears in this file, delete that line immediately.
/.quarto/
**/*.quarto_ipynb
